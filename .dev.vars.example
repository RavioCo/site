# ---------- PUBLIC (safe in the browser bundle) ----------
NEXT_PUBLIC_SITE_URL=https://ravioco.com
# Keep false until: (1) a full sandbox test order passes, (2) the merchant has approved each live gateway.
NEXT_PUBLIC_ORDERING_OPEN=false
NEXT_PUBLIC_FORMS_ENDPOINT=

# ---------- SERVER-ONLY (Cloudflare secrets / .dev.vars; NEVER prefix with NEXT_PUBLIC_) ----------
# Set these with `wrangler secret put NAME`, never commit values.
WC_STORE_URL=https://commerce.ravioco.com
# Optional shared secret; must match `define('RAVIO_PROXY_SECRET', '...')` in wp-config.php. Locks the commerce API to this proxy.
RAVIO_PROXY_SECRET=
# NOT USED by the storefront today (all customer-facing traffic uses the public Store API). Add only if a server-side
# admin operation is introduced later, and then only as Worker secrets:
# WC_REST_CONSUMER_KEY=
# WC_REST_CONSUMER_SECRET=
