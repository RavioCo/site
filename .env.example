# Public, non-secret configuration (safe to expose to the browser).
NEXT_PUBLIC_SITE_URL=https://ravioco.com
# Keep false until real payment + order processing exist.
NEXT_PUBLIC_ORDERING_OPEN=false
# Only used when prices are set in src/lib/products.ts (ISO 4217).
NEXT_PUBLIC_CURRENCY=USD
# Optional: URL of a form-handling endpoint (e.g. a Cloudflare Worker). Leave empty until it exists.
NEXT_PUBLIC_FORMS_ENDPOINT=
# NEVER put secrets (API keys, payment keys) in NEXT_PUBLIC_* variables.
